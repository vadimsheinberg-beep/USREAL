# Скопируйте в .env рядом с landtender.toml. Файл в git не попадает (.gitignore).
#
# 1. Токен бота — получить у @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
#
# 2. Куда слать сводку. Для канала: добавьте бота администратором, напишите
#    в канал любое сообщение и выполните `landtender telegram-test --discover`.
#    У каналов id отрицательный и начинается с -100.
TELEGRAM_CHAT_ID=-1001234567890
#
# 3. Нужен, только если Yad2 потребует авторизованную сессию
# YAD2_COOKIE=
