# Скопируйте в .env рядом с landtender.toml. Файл в git не попадает (.gitignore).
#
# 1. Токен бота — получить у @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
#
# 2. Куда слать сводку. Бот должен быть администратором канала.
#
#    Проще всего — публичное имя канала со знаком @, искать ничего не нужно:
TELEGRAM_CHAT_ID=@my_land_channel
#
#    Для приватного канала нужен числовой id (отрицательный, начинается с -100).
#    Найти его: напишите в канал любое сообщение и выполните
#    `landtender telegram-test --discover`
# TELEGRAM_CHAT_ID=-1001234567890
#
# 3. Нужен, только если Yad2 потребует авторизованную сессию
# YAD2_COOKIE=
#
# ---------------------------------------------------------------------------
# Анализатор расходов (expenses)
#
# Bybit. Ключу нужны ТОЛЬКО права на чтение — торговых прав и прав на
# перевод средств анализатору не требуется. Если ключ где-то засветился,
# удалите его в Bybit → API Management и выпустите новый.
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
#
# Произвольный REST API банка. Имя переменной задаётся в expenses.toml
# ключом token_env — здесь значение по умолчанию.
# EXPENSES_API_TOKEN=
# EXPENSES_API_USER=     # только для auth = "basic"
