[Unit]
Description=Присылать отчёт по расходам в начале каждого месяца

[Timer]
# Первое число, 10:00. К этому моменту прошлый месяц закрыт полностью.
OnCalendar=*-*-01 10:00:00
# Разброс, чтобы запуск не приходился ровно на начало часа
RandomizedDelaySec=1800
# Догнать пропущенный запуск, если сервер был выключен
Persistent=true

[Install]
WantedBy=timers.target
