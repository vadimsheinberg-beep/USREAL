# Скопируйте в /etc/expenses.env, владелец root, права 600:
#   sudo install -m 600 -o root -g root expenses.env.example /etc/expenses.env
#
# Куда слать отчёт. Бот должен быть администратором канала.
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=-1001234567890
#
# Ключи Bybit. Нужны ТОЛЬКО права на чтение — ни торговли, ни переводов.
# В Bybit → API Management можно дополнительно привязать ключ к IP сервера.
BYBIT_API_KEY=
BYBIT_API_SECRET=
#
# Токен банковского API, если подключён источник [sources.rest]
# EXPENSES_API_TOKEN=
